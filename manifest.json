{
  "name": "Butterchurn Music Visualizer Extension",
  "short_name": "Butterchurn Visualizer",
  "version": "0.3.0",
  "manifest_version": 3,
  "description": "Visualizes the audio playing using the MilkDrop 2 visualizer",
  "homepage_url": "https://butterchurnviz.com/extension",
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    },
    "default_title": "Butterchurn Visualizer"
  },
  "permissions": ["tabCapture", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "offline_enabled": true
}
